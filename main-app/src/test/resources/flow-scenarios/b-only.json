      }
    },
    {
      "request": {
        "method": "POST",
        "urlPath": "/partner-b/matches",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.pNumber",
              "equalTo": "PN900003"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "matches": [
            {
              "firstName": "Hana",
