{
  "description": "PNumber and valid license but no SSN: only B is called",
  "method": "POST",
  "path": "/search",
  "request": {
    "header": {
      "requestId": "b-only",
      "source": "flow-scenario",
      "timestamp": "2026-10-20T12:00:00Z"
    },
    "documents": [
      {
        "documentType": "DRIVER_LICENSE",
        "documentNumber": "F00000003"
      }
    ],
    "person": {
      "first": "Hana",
      "last": "Cole",
      "pNumber": "PN900003",
      "birthDate": "1990-09-09"
    }
  },
  "expectedStatus": 200,
  "expect": {
    "calls": [
      {
        "request": {
          "method": "POST",
          "urlPath": "/legacy-id-provider/lookup",
          "bodyPatterns": [
            {
              "matchesJsonPath": {
                "expression": "$.lastName",
                "equalTo": "Cole"
              }
            }
          ]
        },
        "count": 1,
        "why": "The new ID provider is switched off, which is the default"
      },
      {
        "request": {
          "method": "POST",
          "urlPath": "/new-id-provider/lookup"
        },
        "count": 0
      },
      {
        "request": {
          "method": "POST",
          "urlPath": "/partner-a/matches"
        },
        "count": 0,
        "why": "Partner A needs an SSN, and this person has none"
      },
      {
        "request": {
          "method": "POST",
          "urlPath": "/partner-b/matches",
          "bodyPatterns": [
            {
              "matchesJsonPath": {
                "expression": "$.pNumber",
                "equalTo": "PN900003"
              }
            },
            {
              "matchesJsonPath": {
                "expression": "$.documentNumber",
                "equalTo": "F00000003"
              }
            },
            {
              "matchesJsonPath": {
                "expression": "$.birthDate",
                "equalTo": "1990-09-09"
              }
            }
          ]
        },
        "count": 1,
        "why": "Partner B needs a PNumber and a valid driver license"
      },
      {
        "request": {
          "method": "POST",
          "urlPath": "/partner-c/matches"
        },
        "count": 0,
        "why": "Partner C needs an SSN, and this person has none"
      }
    ],
    "response": {
      "bodyPatterns": [
        {
          "matchesJsonPath": {
            "expression": "$.personId",
            "equalTo": "LEGACY-COLE"
          }
        },
        {
          "matchesJsonPath": {
            "expression": "$.results.length()",
            "equalTo": "1"
          }
        },
        {
          "matchesJsonPath": {
            "expression": "$.results[0].partner",
            "equalTo": "PARTNER_B"
          }
        }
      ]
    }
  },
  "stubs": [
    {
      "request": {
        "method": "POST",
        "urlPath": "/legacy-id-provider/lookup",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
