            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "urlPath": "/partner-b/matches",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.pNumber",
              "equalTo": "PN900006"
            }
          }
        ]
